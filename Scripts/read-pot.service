[Unit]
Description=Runs a script which monitors a potentiometer and transmits messages over MQTT.
After=multi-user.target
Conflicts=getty@tty1.service

[Service]
Type=simple
TimeoutStartSec=300
ExecStartPre=/bin/sleep 150
ExecStart=/usr/bin/python3 /home/nathan/large-language-machine/pot-read.py
StandardInput=tty-force
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.targetz
