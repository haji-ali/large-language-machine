[Unit]
Description=Runs a script which monitors a potentiometer and transmits messages over MQTT.
StartLimitIntervalSec=0

[Service]
Type=simple
# Starts straight away: the script connects to the broker in the background and
# keeps retrying, so the router, the PC and the other readers can come up in any order
ExecStart=/usr/bin/python3 /home/nathan/large-language-machine/pot-read.py
# Send print() output to the journal as it happens
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
