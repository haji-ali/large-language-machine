[Unit]
Description=Run Large Language Machine in a fullscreen terminal
After=display-manager.service
Requires=display-manager.service

[Service]
User=nathan
Group=nathan

Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/nathan/.Xauthority

ExecStart=/usr/bin/bash -c 'gnome-terminal --full-screen -- bash -c "~/scripts/run-ll-machine.sh; exec bash"'

Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target