[Unit]
Description=Runs a script which monitors a button and transmits messages over MQTT.
After=multi-user.target
Conflicts=getty@tty1.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/nathan/intelligence-builder/button.py
StandardInput=tty-force
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
