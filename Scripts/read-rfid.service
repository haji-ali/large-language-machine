[Unit]
Description=Runs an RFID reader script which transmits messages over MQTT.
After=multi-user.target
Conflicts=getty@tty1.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/nathan/intelligence-builder/rfid-read.py
StandardInput=tty-force
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
