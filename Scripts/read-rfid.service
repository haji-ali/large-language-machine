[Unit]
Description=Runs an RFID reader script which transmits messages over MQTT.
# The reader is on the serial port the serial console would otherwise use
Conflicts=serial-getty@ttyS0.service
StartLimitIntervalSec=0

[Service]
Type=simple
# Starts straight away: the script connects to the broker in the background and
# keeps retrying, so the router, the PC and the other readers can come up in any order
ExecStart=/usr/bin/python3 /home/nathan/large-language-machine/rfid-read.py
# Send print() output to the journal as it happens
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
